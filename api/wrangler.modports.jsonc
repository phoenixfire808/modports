{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modports-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.modports.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "rustports-metadata",
    "database_id": "9d40876f-72b2-4039-afa1-4a8ee71ae1ab"
  }],
  "vars": {
    "SITE_ORIGIN": "https://modports.com",
    "GITHUB_CALLBACK_URL": "https://api.modports.com/auth/github/callback",
    "MODERATOR_GITHUB_IDS": "127261791"
  }
}
