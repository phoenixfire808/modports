index 706576f..5b5136c 100644
--- a/src/cli/args/tests.rs
+++ b/src/cli/args/tests.rs
@@ -1044,3 +1044,29 @@ fn api_stdio_accepts_alias_and_daemon_socket_but_not_api_socket() {
         );
     }
 }
+
+#[test]
+fn workbook_commands_parse_without_starting_session_commands() {
+    let inspect =
+        Args::try_parse_from(["jcode", "workbook", "inspect", "model.xlsx", "--json"]).unwrap();
+    assert!(matches!(
+        inspect.command,
+        Some(Command::Workbook(WorkbookCommand::Inspect { input, json: true })) if input == "model.xlsx"
+    ));
+
+    let build =
+        Args::try_parse_from(["jcode", "workbook", "build", "--config", "project.toml"]).unwrap();
+    assert!(matches!(
+        build.command,
+        Some(Command::Workbook(WorkbookCommand::Build { config: Some(config), json: false })) if config == "project.toml"
+    ));
+
+    let check = Args::try_parse_from(["jcode", "workbook", "check"]).unwrap();
+    assert!(matches!(
+        check.command,
+        Some(Command::Workbook(WorkbookCommand::Check {
+            config: None,
+            json: false
+        }))
+    ));
+}
